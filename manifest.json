{
  "manifest_version": 3,
  "name": "GitLab Review Checker",
  "version": "0.2.0",
  "description": "Shows open GitLab merge requests waiting on your review.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["alarms", "storage"],
  "optional_host_permissions": ["*://*/*"]
}
